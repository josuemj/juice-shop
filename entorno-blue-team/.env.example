# --- Versiones ---
ELASTIC_VERSION=8.19.24
JUICE_SHOP_IMAGE=bkimminich/juice-shop:v20.3.0

# --- Credenciales del SIEM ---
# Usuario de Kibana: elastic / ELASTIC_PASSWORD
ELASTIC_PASSWORD=
KIBANA_PASSWORD=
KIBANA_ENCRYPTION_KEY=cambiar-por-32-caracteres-aleatorios-minimo

# --- WAF ---
# DetectionOnly = solo registra
# On            = bloquea con 403 
MODSEC_RULE_ENGINE=DetectionOnly
# RelevantOnly = registra solo lo que dispara reglas o da error
# On           = registra todas las peticiones (util para ver trafico legitimo)
MODSEC_AUDIT_ENGINE=RelevantOnly
# Nivel de paranoia del CRS (1 a 4). Mas alto = mas deteccion y mas falsos positivos
PARANOIA=1
ANOMALY_INBOUND=5
ANOMALY_OUTBOUND=4

# 127.0.0.1 = solo esta laptop.
# 0.0.0.0   = otras laptops de la misma red pueden atacar
WAF_BIND=127.0.0.1

# Memoria de Elasticsearch. Bajar a 512m si la laptop tiene poca RAM.
ES_HEAP=1g